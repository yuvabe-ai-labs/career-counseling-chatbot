NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Copy these values from the Supabase project dashboard. Never commit real secrets.
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Use the Session Pooler connection string on IPv4-only networks.
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-your-region.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Gemini powers the clusterfit chat (Live API) and the post-chat extraction. Create the
# server-side key in Google AI Studio. Without it the chat is unavailable and students go
# straight to the confirm card.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Tried in order. Lite first: on a full chat flash-latest took 23 s vs 3.8 s (Lambda limit 30 s).
CLUSTERFIT_EXTRACTION_MODELS=gemini-flash-lite-latest,gemini-flash-latest
# Total extraction time budget (ms). 27000 fits Lambda's 30 s timeout; raise with the Lambda timeout.
CLUSTERFIT_EXTRACTION_BUDGET_MS=27000

# Email delivery for the guardian-consent OTP (students under 18). No SMS/phone delivery and no
# dev-echo/no-op fallback exist: leaving these blank means OTP requests fail with a clear 503.
# Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
