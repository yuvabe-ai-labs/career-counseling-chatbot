NODE_ENV=development
COUNSELOR_RUNTIME=unconfigured
COUNSELOR_FIXTURE_TOKEN=fixture-token
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Copy these values from the Supabase project dashboard. Never commit real secrets.
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
INTERNAL_API_KEY=replace-with-at-least-32-random-characters

# Use the Session Pooler connection string on IPv4-only networks.
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-your-region.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# AI provider. Use gemini, anthropic, disabled, or auto (Gemini first, then Anthropic).
AI_PROVIDER=gemini

# Optional Gemini integration. Create the server-side key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=700
GEMINI_TIMEOUT_MS=60000
GEMINI_THINKING_LEVEL=minimal

# Optional Claude integration. Both values are required when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=700
ANTHROPIC_TIMEOUT_MS=15000

# Module 5 safety service. Not needed here: the counselor calls Module 5's safety check
# in-process (same server) whenever both modules are running together, which they are. Only
# set SAFETY_SERVICE_URL if Safety is ever split out into its own deployed service.
SAFETY_SERVICE_TIMEOUT_MS=5000

# Email delivery for identity OTP and guardian consent (Module 1) — no SMS/phone delivery,
# and no dev-echo/no-op fallback, exists anywhere in the app. Leaving these blank means OTP
# requests fail with a clear 503 (no real email sent) rather than a silent fake send — that's
# fine for exercising unrelated parts of the app, but required to actually test/use Module 1's
# identity or guardian-consent flows, and required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
